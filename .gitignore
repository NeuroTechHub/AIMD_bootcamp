# --- OS junk ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- editors ----------------------------------------------------------------
# Keep .vscode/settings.json (pins live-server port for everyone), ignore the rest.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- python (build/_build_bootcamp.py) --------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- node (in case any module pulls in JS tooling) --------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- logs / scratch ---------------------------------------------------------
*.log
.cache/
tmp/
# anything under build/ starting with `_` is scratch (logo hunts, frame
# previews, extracted media for inspection — not part of the build pipeline).
build/_*/

# --- notebook runtime artefacts --------------------------------------------
*.pt
modules/M1-computer-vision-notebooks/assets/
modules/M5-decoding-and-closed-loop/assets/

# --- archived / reference-only material -------------------------------------
# `old/` keeps style references and superseded drafts out of the repo.
old/

# --- presentations: derived artefacts and source-deck mining ----------------
# Keep:
#   presentations/Neurotech Bootcamp prelude.pptx   (hand-authored)
#   presentations/bootcamp-deck.pptx                (generated, but embeds the
#                                                    figures it needs)
# Ignore:
#   - PDF exports (regenerable from pptx via PowerPoint) and pptx for now
#   - presentations/sources/ — extracted images, transcripts, and PDF mirrors
#     of third-party decks pulled in for reference. Re-extract locally with
#     build/_extract_pptx_assets.py <source.pptx> presentations/sources/<name>/
presentations/*.pdf
presentations/*.pptx
presentations/*.pptx.bak
presentations/sources/
presentations/feedback/

# --- secrets ----------------------------------------------------------------
.env
.env.local
*.pem

# --- Claude Code local state ------------------------------------------------
.claude/
